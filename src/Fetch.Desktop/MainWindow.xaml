<Window x:Class="Fetch.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Fetch — Download Manager" Width="1340" Height="790" MinWidth="1030" MinHeight="610"
    WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}" Foreground="White"
    FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="13,12" />
            <Setter Property="Background" Value="#283D54" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A1B5C8" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Command="{Binding AddCommand}" Key="Return" Modifiers="Control" />
        <KeyBinding Command="{Binding PauseCommand}" Key="P" Modifiers="Control" />
        <KeyBinding Command="{Binding ResumeCommand}" Key="R" Modifiers="Control" />
        <KeyBinding Command="{Binding RemoveCommand}" Key="Delete" />
        <KeyBinding Command="{Binding PasteUrlCommand}" Key="L" Modifiers="Control" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="29" />
        </Grid.RowDefinitions>

        <!-- Real commands only; unavailable IDM-style features are not represented by fake buttons. -->
        <Menu Grid.Row="0" Background="#0D1726" Foreground="#EDF5FC" Padding="7,1">
            <MenuItem Header="Tasks">
                <MenuItem Header="Add URL" Command="{Binding AddCommand}" InputGestureText="Ctrl+Enter" />
                <MenuItem Header="Paste URL from clipboard" Command="{Binding PasteUrlCommand}" InputGestureText="Ctrl+L" />
                <MenuItem Header="Download media URL via yt-dlp" Command="{Binding AddMediaCommand}" />
                <Separator />
                <MenuItem Header="Start / Resume selected" Command="{Binding ResumeCommand}" />
                <MenuItem Header="Pause selected" Command="{Binding PauseCommand}" />
                <MenuItem Header="Pause all" Command="{Binding PauseAllCommand}" />
                <MenuItem Header="Resume unfinished" Command="{Binding ResumeAllCommand}" />
                <Separator />
                <MenuItem Header="Remove selected entry" Command="{Binding RemoveCommand}" />
                <MenuItem Header="Clear completed history" Command="{Binding ClearCompletedCommand}" />
            </MenuItem>
            <MenuItem Header="Downloads">
                <MenuItem Header="Open downloaded file" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open containing folder" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Copy selected URL" Command="{Binding CopyUrlCommand}" />
                <MenuItem Header="Change default download folder" Command="{Binding BrowseCommand}" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About Fetch and supported features" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#17283C" Padding="20,15,20,14" BorderBrush="#284157" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,13">
                    <TextBlock Text="⇣" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text=" Fetch" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  •  download manager" Foreground="#93ADBF" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource ToolbarButton}" Content="＋  Add URL" Command="{Binding AddCommand}"
                            Background="{StaticResource Accent}" Foreground="#102635" />
                    <Button Style="{StaticResource ToolbarButton}" Content="▶  Download video" Command="{Binding AddMediaCommand}"
                            ToolTip="Download a permitted media page or stream via yt-dlp (separate installation required)" />
                    <Button Style="{StaticResource ToolbarButton}" Content="▶  Resume" Command="{Binding ResumeCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="Ⅱ  Pause" Command="{Binding PauseCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="⏸  Pause all" Command="{Binding PauseAllCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="▷  Start all" Command="{Binding ResumeAllCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="✕  Delete" Command="{Binding RemoveCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="✓  Clear finished" Command="{Binding ClearCompletedCommand}" />
                    <Button Style="{StaticResource ToolbarButton}" Content="📂  Folder" Command="{Binding OpenFolderCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="#192B40" Padding="17,11" BorderBrush="#2B4359" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="URL" Foreground="#A9BED0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,13,0" />
                <TextBox Grid.Column="1" Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Direct HTTP or HTTPS file address" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="Paste" Command="{Binding PasteUrlCommand}" Margin="9,0,0,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding MediaQualityChoices}"
                          SelectedItem="{Binding MediaQuality}" MinWidth="105" Height="37"
                          Background="#283D54" Foreground="#F1F8FF" Margin="8,0,0,0"
                          ToolTip="Media quality for Download video; direct file downloads ignore this setting">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#283D54" />
                            <Setter Property="Foreground" Value="#F1F8FF" />
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#48C8BB" />
                                    <Setter Property="Foreground" Value="#09222A" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Button Grid.Column="4" Content="Download" Command="{Binding AddCommand}"
                        Background="{StaticResource Accent}" Foreground="#102635" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="14,13,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="9" Background="{StaticResource CardSurface}" Padding="0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="15,2,12,12">
                        <TextBlock Text="LIBRARY" Foreground="#829CB7" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text="Browse downloads" FontWeight="SemiBold" Foreground="#DBE9F6" Margin="0,6,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" Foreground="White" Margin="8,0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" Padding="9,8" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#B6C9DA" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2C5F67" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardSurface}" CornerRadius="9" Padding="5">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="11,9,11,11">
                        <TextBlock Text="{Binding FilterTitle}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding JobCountText}" Foreground="#93AABF"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding JobsView}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                        AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                        Background="Transparent" Foreground="White" BorderThickness="0" GridLinesVisibility="None"
                        RowBackground="#1D2B40" AlternatingRowBackground="#23354A" RowHeight="54"
                        ColumnHeaderHeight="39" HeadersVisibility="Column" SelectionUnit="FullRow">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#293E54" />
                                <Setter Property="Foreground" Value="#D0DEEC" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,8" />
                            </Style>
                            <!-- Windows default selected-cell brushes were painting white on white. -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285766" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#285766" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#F0F8FF" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="7,5" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#285766" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#285766" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Resume / Start" Command="{Binding PlacementTarget.DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Pause" Command="{Binding PlacementTarget.DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Open file" Command="{Binding PlacementTarget.DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Open folder" Command="{Binding PlacementTarget.DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Copy URL" Command="{Binding PlacementTarget.DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Remove from list" Command="{Binding PlacementTarget.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File name" Binding="{Binding Name}" Width="2.2*" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="0.85*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="0.8*" />
                            <DataGridTemplateColumn Header="Progress" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding ProgressText}" Foreground="#B7CDD9" FontSize="11" Margin="0,0,0,3" />
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                                                         Height="7" Background="#35465B" Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.95*" />
                            <DataGridTextColumn Header="Time left" Binding="{Binding RemainingText}" Width="0.82*" />
                            <DataGridTextColumn Header="Transfer rate" Binding="{Binding SpeedText}" Width="0.95*" />
                            <DataGridTextColumn Header="Added" Binding="{Binding DateText}" Width="1.2*" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.25*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#192B40" BorderBrush="#2E435B" BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0" Margin="14,5,14,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="SELECTED DOWNLOAD" Foreground="#8DA9C0" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedUrl}" Foreground="#D3E4F0" TextTrimming="CharacterEllipsis" Margin="0,5,10,0" />
                    <TextBlock Text="{Binding SelectedPath}" Foreground="#98AFC2" TextTrimming="CharacterEllipsis" Margin="0,3,10,0" />
                    <TextBlock Text="{Binding SelectedError}" Foreground="#F3B2A5" TextWrapping="Wrap" Margin="0,6,10,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Open file" Command="{Binding OpenFileCommand}" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <Button Content="Change folder…" Command="{Binding BrowseCommand}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#0C1725" Padding="16,5">
            <DockPanel>
                <TextBlock Text="{Binding SummaryText}" Foreground="#B9CDE0" VerticalAlignment="Center" />
                <TextBlock Text="Direct HTTP(S) • TLS verification enabled • Downloads are never silently overwritten"
                           DockPanel.Dock="Right" Foreground="#7D9AAF" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
