{
  "manifest_version": 3,
  "name": "Fetch Download Manager Companion",
  "version": "0.7.0",
  "description": "Send links and exposed media playlists to your local Fetch downloader.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "downloads",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fetch Download Manager",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media-utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
